# cinder_advanced.conf — the switches most people never need, in one file.
#
# Copy this to the top of the player's storage as  cinder_advanced.conf  and remove the # in front
# of a line to switch it on. Everything is off (commented) by default, and deleting the file puts
# every switch back. A line is  name  or  name=on ; name=off is the same as leaving it out.
# Changes to the power switches take effect within a second; the rest are read at start.
#
# (Each switch also still works the old way, as an empty file called cinder_<name>; the values
# below still work as cinder_suspend_s, cinder_cpufloor.conf and cinder_mediastore.conf.)

# ── Power ────────────────────────────────────────────────────────────────────────────────────
# Sleep fully (suspend to RAM) when paused, screen off, off the cable, for a minute.
#ram_suspend
# The same deep sleep is on by default in dev builds; this turns it off there.
#no_ram_suspend
# Never enter the light sleep Cinder uses behind a dark screen.
#no_suspend
# Keep the light sleep, but not while music plays on the headphone jack / over Bluetooth.
#no_suspend_playing
#no_suspend_bt
# Leave the processor's speed alone behind a dark screen.
#no_cpu_tune
# Seconds of dark screen before the light sleep (default 5; 0 turns it off).
#suspend_s=5
# Hold the processor at least this fast while playing (default off). 598000 / 747500 / 1040000 / 1300000.
#cpufloor_khz=1040000

# ── Other ────────────────────────────────────────────────────────────────────────────────────
# Do not write /contents/.scrobbler.log (for players that run another scrobbler).
#no_scrobble
# Hold a song (instead of swiping it left) to play it next.
#hold_play_next

# ── Diagnostics (for bug reports; leave off) ─────────────────────────────────────────────────
#no_fbsync
#async_library
#automsc_on
# Record Sony noise-cancelling diagnostics at start and on every headphone change (issue #27).
#nc_probe
# Where Sony's library lives and which folders it scans (defaults shown).
#mediastore_db=/db/MTPDB.dat
#mediastore_root=/data/mnt/
#mediastore_dirs=MUSIC,LEARNING
# One more folder to scan, beside the root (default none).
#mediastore_extra=
